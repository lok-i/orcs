+def compute_egohtr_terrain_rows(qpos, object_pose, cache, margin):
+    """Native contact manifolds, including every corner of flat hand boxes.
+
+    A single geomDistance witness can jump between mesh/box features inside a
+    penetration. Contact normals give the QP each active separating direction.
+    """
+    model, data = cache["model"], cache["data"]
+    robot_nv = cache["robot_nv"]
+    mujoco.mj_resetData(model, data)
+    data.qpos[:cache["robot_nq"]] = qpos
+    addr = cache["object_qadr"]
+    data.qpos[addr:addr+7] = object_pose
+    mujoco.mj_kinematics(model, data)
+    mujoco.mj_comPos(model, data)
+    robot = np.asarray(cache["robot_geom_ids"])
+    terrain = np.asarray(cache["object_geom_ids"])
+    robot_set, terrain_set = set(robot), set(terrain)
+    saved = (model.geom_contype.copy(), model.geom_conaffinity.copy(), model.geom_margin.copy())
+    rows, distances = [], []
+    try:
+        model.geom_contype[robot], model.geom_conaffinity[robot] = 1, 2
+        model.geom_contype[terrain], model.geom_conaffinity[terrain] = 2, 1
+        model.geom_margin[:] = np.maximum(saved[2], max(.03, margin))
+        mujoco.mj_collision(model, data)
+        for contact in data.contact[:data.ncon]:
+            g1, g2 = int(contact.geom1), int(contact.geom2)
+            if not ((g1 in robot_set and g2 in terrain_set) or
+                    (g2 in robot_set and g1 in terrain_set)):
+                continue
+            normal = np.asarray(contact.frame[:3])
+            delta = .5 * float(contact.dist) * normal
+            j1 = common.body_point_jacobian(model, data, int(model.geom_bodyid[g1]), contact.pos-delta)
+            j2 = common.body_point_jacobian(model, data, int(model.geom_bodyid[g2]), contact.pos+delta)
+            rows.append((normal @ (j2-j1))[:robot_nv])
+            distances.append(float(contact.dist))
+    finally:
+        model.geom_contype[:], model.geom_conaffinity[:], model.geom_margin[:] = saved
+    return rows, distances
+
