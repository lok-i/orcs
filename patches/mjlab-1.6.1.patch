diff --git a/docs/source/changelog.rst b/docs/source/changelog.rst
index 96e4e18..b7a0687 100644
--- a/docs/source/changelog.rst
+++ b/docs/source/changelog.rst
@@ -5,6 +5,25 @@ Changelog
 Upcoming version (not yet released)
 -----------------------------------
 
+Changed
+^^^^^^^
+
+- Consumer compatibility patch: use MuJoCo Core 4.0.1 and the pinned MuJoCo
+  Warp source snapshot with scalar-first geometry/site quaternions. Preserve
+  ViBe's rsl-rl-lib 5.4.1 fork in the consumer's single dependency resolution.
+
+Added
+^^^^^
+
+- Explicit Warp/OptiX camera backend selection. OptiX requires compatible
+  bindings and drivers, rejects raycast sensors and silent backend fallback,
+  and renders outside CUDA capture while physics remains captured.
+
+Fixed
+^^^^^
+
+- Warm up lazy renderer resources before CUDA graph capture.
+
 Version 1.6.0 (August 8, 2026)
 ------------------------------
 
