+  @absltest.skipUnless("optix" in _BACKENDS, "OptiX GPU required")
+  def test_optix_translated_worlds(self):
+    """Translated simulation origins must not overlap OptiX world cells."""
+    mjm, _, m, d = test_data.fixture(
+      xml="""<mujoco><worldbody>
+        <camera pos="0 -3 1" xyaxes="1 0 0 0 0.3 1"/>
+        <geom type="plane" size="0 0 0.1" rgba="0.2 0.2 0.2 1"/>
+        <geom type="box" size="0.4 0.4 0.4" pos="0 0 0.4" rgba="1 0 0 1"/>
+      </worldbody></mujoco>""",
+      nworld=2,
+    )
+    origins = np.array([[-63, -63, 0], [63, 63, 0]], dtype=np.float32)
+    d.geom_xpos.assign(d.geom_xpos.numpy() + origins[:, None])
+    d.cam_xpos.assign(d.cam_xpos.numpy() + origins[:, None])
+    contexts = []
+    for backend in ("warp", "optix"):
+      rc = mjw.create_render_context(
+        mjm, nworld=2, cam_res=(32, 32), render_rgb=True, render_seg=True,
+        use_textures=False, backend=backend,
+        optix_world_extent=63 + max(4 * mjm.stat.extent, 1),
+      )
+      self.assertEqual(rc.backend, backend)
+      mjw.refit_bvh(m, d, rc)
+      mjw.render(m, d, rc)
+      wp.synchronize()
+      contexts.append(rc)
+    np.testing.assert_array_equal(contexts[0].seg_data.numpy(), contexts[1].seg_data.numpy())
+    rgb = [_unpack_rgb(rc.rgb_data.numpy()).astype(float) for rc in contexts]
+    self.assertGreater(np.count_nonzero(rgb[0][..., 0] > rgb[0][..., 1]), 20)
+    np.testing.assert_allclose(rgb[0], rgb[1], atol=2)
+
